config_version=5

[application]
boot_splash/image="res://assets/start_screen.jpg"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/image="res://assets/summit_forge_splash.svg"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/show_image=true
config/name="CLIMB MASTER"
config/icon="res://assets/app_icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.105, 1)
